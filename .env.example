@"
FLASK_ENV=development
FLASK_DEBUG=True
PORT=8080
"@ | Out-File -FilePath ".env.example" -Encoding UTF8

@"
__pycache__/
*.py[cod]
*`$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
github-actions-key.json
"@ | Out-File -FilePath ".gitignore" -Encoding UTF8

git add .env.example .gitignore
git commit -m "feat: add environment configuration and gitignore"
git push origin main