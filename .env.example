# PASO 1: Crear archivo .env.production (en la carpeta raíz)
@"
FLASK_ENV=production
FLASK_DEBUG=False
PORT=8080
MAX_CONTENT_LENGTH=16777216
CORS_ENABLED=True
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=True
"@ | Out-File -FilePath ".env.production" -Encoding UTF8

# PASO 2: Crear archivo .env.development (en la carpeta raíz)
@"
FLASK_ENV=development
FLASK_DEBUG=True
PORT=8080
MAX_CONTENT_LENGTH=16777216
CORS_ENABLED=False
LOG_LEVEL=DEBUG
RATE_LIMIT_ENABLED=False
"@ | Out-File -FilePath ".env.development" -Encoding UTF8

# PASO 3: Crear script health_check.py (en la carpeta raíz)
@"
import requests
import time
import sys

def check_health(url, max_retries=5):
    """Verificar salud de la aplicación"""
    for attempt in range(max_retries):
        try:
            response = requests.get(f"{url}/health", timeout=10)
            if response.status_code == 200:
                data = response.json()
                print(f"✅ Service healthy: {data.get('service')} - {data.get('status')}")
                return True
            else:
                print(f"❌ Health check failed: HTTP {response.status_code}")
        except Exception as e:
            print(f"🔄 Attempt {attempt + 1}: {str(e)}")
            time.sleep(2)
    
    return False

if __name__ == "__main__":
    url = sys.argv[1] if len(sys.argv) > 1 else "http://localhost:8080"
    success = check_health(url)
    sys.exit(0 if success else 1)
"@ | Out-File -FilePath "health_check.py" -Encoding UTF8

# PASO 4: Agregar dependencias para monitoreo
Add-Content -Path "requirements.txt" -Value "requests==2.31.0"

# PASO 5: Hacer commit
git add .env.production .env.development health_check.py requirements.txt
git commit -m "feat: add production configuration and monitoring tools"
git push origin main